# OpenAI-compatible LLM endpoint
LLM_BASE_URL="https://ia.beta.utc.fr/api"
LLM_API_KEY="YOUR_LLM_API_KEY"
LLM_MODEL="mistral-small3.2:latest"

# OpenAI-compatible embeddings endpoint
EMBEDDING_BASE_URL="https://ia.beta.utc.fr/api"
EMBEDDING_API_KEY="YOUR_EMBEDDING_API_KEY"
EMBEDDING_MODEL="rhundt/GLM-4-0414-32b-128k-Q4_K_M:latest"
EMBEDDING_PATH="/embeddings"
EMBEDDING_API_FORMAT="openwebui"

# If the endpoint is Open WebUI's Ollama proxy, use:
# EMBEDDING_BASE_URL="https://ia.beta.utc.fr"
# EMBEDDING_MODEL="embeddinggemma:300m"
# EMBEDDING_PATH="/ollama/api/embeddings"
# EMBEDDING_API_FORMAT="ollama_embeddings"

# Chroma
CHROMA_DIR="chroma_db"
CHROMA_COLLECTION="legifrance_propriete_intellectuelle"

# Legifrance
LEGIFRANCE_URL="https://www.legifrance.gouv.fr/codes/texte_lc/LEGITEXT000006069414"
LEGIFRANCE_MAX_PAGES=25

# RAG
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVER_K=5
EMBEDDING_BATCH_SIZE=8
EMBEDDING_SLEEP_SECONDS=1.0
EMBEDDING_MAX_RETRIES=5
